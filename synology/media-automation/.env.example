# Copy this file to .env on the Synology and replace PUID/PGID with the IDs of
# a dedicated DSM account that has read/write access only to the listed media
# and configuration directories.
PUID=1026
PGID=100

TZ=Europe/Amsterdam
WEB_BIND_ADDRESS=192.168.1.59
TORRENTING_PORT=6881
CONFIG_ROOT=/volume1/docker/media-automation
MEDIA_ROOT=/volume1/media

# Keep production logs concise. Change to debug only while troubleshooting.
SEERR_LOG_LEVEL=info
